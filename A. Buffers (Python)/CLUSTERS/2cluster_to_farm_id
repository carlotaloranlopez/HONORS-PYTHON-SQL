# --------------------------------------------------------------------------------------------
# This file obtains farm IDs contained in each cluster
# --------------------------------------------------------------------------------------------

# --------------------------------------------------------------------------------------------
# SETUP
# --------------------------------------------------------------------------------------------

# Dependencies & delete shapefile function definition
import os
import processing
from qgis.core import QgsProcessingFeatureSourceDefinition, QgsFeatureRequest
def delete_shapefile(path):
    for ext in [".shp", ".shx", ".dbf", ".prj", ".cpg"]:
        p = path.replace(".shp", ext)
        if os.path.exists(p):
            os.remove(p)

# Set working directory and file paths
cd = "/zfs/students/cloranlo/Downloads/CREDIT_DEFOREST/DATA/DATA_CLEAN/CREDIT/GLEBAS/FARMS/NF_BUFFERS/"
b0= os.path.join(cd, "b0/b0.shp")
b0_f= os.path.join(cd, "b0/b0.shp")
cd = "/zfs/students/cloranlo/Downloads/CREDIT_DEFOREST/DATA/DATA_CLEAN/CREDIT/GLEBAS/CLUSTERS/"
cluster250= os.path.join(cd, "b250_cluster/b250_cluster.shp")
cluster250_fixed= os.path.join(cd, "b250_cluster/b250_cluster_fixed.shp")
cluster500= os.path.join(cd, "b500_cluster/b500_cluster.shp")
cluster500_fixed= os.path.join(cd, "b500_cluster/b500_cluster_fixed.shp")
cluster1000= os.path.join(cd, "b1000_cluster/b1000_cluster.shp")
cluster1000_fixed= os.path.join(cd, "b1000_cluster/b1000_cluster_fixed.shp")
cluster2000= os.path.join(cd, "b2000_cluster/b2000_cluster.shp")
cluster2000_fixed= os.path.join(cd, "b2000_cluster/b2000_cluster_fixed.shp")
cd = "/zfs/students/cloranlo/Downloads/CREDIT_DEFOREST/DATA/DATA_CLEAN/CREDIT/GLEBAS/"
cluster250_to_farm_id= os.path.join(cd, "cluster250_to_farm_id.csv")
cluster500_to_farm_id= os.path.join(cd, "cluster500_to_farm_id.csv")
cluster1000_to_farm_id= os.path.join(cd, "cluster1000_to_farm_id.csv")
cluster2000_to_farm_id= os.path.join(cd, "cluster2000_to_farm_id.csv")

# Delete existing outputs if they exist
for f in [b0_f, cluster250_fixed, cluster500_fixed, cluster1000_fixed, cluster2000_fixed, cluster250_to_farm_id, cluster500_to_farm_id, cluster1000_to_farm_id, cluster2000_to_farm_id]:
    delete_shapefile(f)


# --------------------------------------------------------------------------------------------
# FIX GEOMETRIES
# --------------------------------------------------------------------------------------------

processing.run("native:fixgeometries", {
    'INPUT': cluster250,
    'METHOD': 1,
    'OUTPUT': cluster250_fixed
    }
)
processing.run("native:fixgeometries", {
    'INPUT': cluster500,
    'METHOD': 1,
    'OUTPUT': cluster500_fixed
    }
)
processing.run("native:fixgeometries", {
    'INPUT': cluster1000,
    'METHOD': 1,
    'OUTPUT': cluster1000_fixed
    }
)
processing.run("native:fixgeometries", {
    'INPUT': cluster2000,
    'METHOD': 1,
    'OUTPUT': cluster2000_fixed
    }
)
processing.run("native:fixgeometries", {
    'INPUT': b0,
    'METHOD': 1,
    'OUTPUT': b0_f
    }
)


# --------------------------------------------------------------------------------------------
# DROP IF BAD GEOMETRY
# --------------------------------------------------------------------------------------------

cluster_250_src = QgsProcessingFeatureSourceDefinition(
    cluster250_fixed,
    flags=QgsProcessingFeatureSourceDefinition.FlagOverrideDefaultGeometryCheck,
    geometryCheck=QgsFeatureRequest.GeometrySkipInvalid
)
cluster_500_src = QgsProcessingFeatureSourceDefinition(
    cluster500_fixed,
    flags=QgsProcessingFeatureSourceDefinition.FlagOverrideDefaultGeometryCheck,
    geometryCheck=QgsFeatureRequest.GeometrySkipInvalid
)
cluster_1000_src = QgsProcessingFeatureSourceDefinition(
    cluster1000_fixed,
    flags=QgsProcessingFeatureSourceDefinition.FlagOverrideDefaultGeometryCheck,
    geometryCheck=QgsFeatureRequest.GeometrySkipInvalid
)
cluster_2000_src = QgsProcessingFeatureSourceDefinition(
    cluster2000_fixed,
    flags=QgsProcessingFeatureSourceDefinition.FlagOverrideDefaultGeometryCheck,
    geometryCheck=QgsFeatureRequest.GeometrySkipInvalid
)
b0_src = QgsProcessingFeatureSourceDefinition(
    b0_f,
    flags=QgsProcessingFeatureSourceDefinition.FlagOverrideDefaultGeometryCheck,
    geometryCheck=QgsFeatureRequest.GeometrySkipInvalid
)


# --------------------------------------------------------------------------------------------
# MERGE BY LOCATION
# --------------------------------------------------------------------------------------------

processing.run("native:joinattributesbylocation", {
    'INPUT': cluster_250_src,
    'PREDICATE':[1,2,4],
    'JOIN': b0_src,
    'JOIN_FIELDS':['fid'],
    'METHOD':0,
    'DISCARD_NONMATCHING':False,
    'PREFIX':'c',
    'OUTPUT':cluster250_to_farm_id
})
processing.run("native:joinattributesbylocation", {
    'INPUT': cluster_500_src,
    'PREDICATE':[1,2,4],
    'JOIN': b0_src,
    'JOIN_FIELDS':['fid'],
    'METHOD':0,
    'DISCARD_NONMATCHING':False,
    'PREFIX':'c',
    'OUTPUT':cluster500_to_farm_id
})
processing.run("native:joinattributesbylocation", {
    'INPUT': cluster_1000_src,
    'PREDICATE':[1,2,4],
    'JOIN': b0_src,
    'JOIN_FIELDS':['fid'],
    'METHOD':0,
    'DISCARD_NONMATCHING':False,
    'PREFIX':'c',
    'OUTPUT':cluster1000_to_farm_id
})
processing.run("native:joinattributesbylocation", {
    'INPUT': cluster_2000_src,
    'PREDICATE':[1,2,4],
    'JOIN': b0_src,
    'JOIN_FIELDS':['fid'],
    'METHOD':0,
    'DISCARD_NONMATCHING':False,
    'PREFIX':'c',
    'OUTPUT':cluster2000_to_farm_id
})
